# ── Google Cloud ──────────────────────────────────────────────────────────────
PROJECT_ID=general-ak
LOCATION=us-central1

# ── Vertex AI Live API (Workload Identity — no API key needed on GKE) ─────────
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=general-ak
GOOGLE_CLOUD_LOCATION=us-central1

# ── Vertex AI RAG Corpus ──────────────────────────────────────────────────────
# The numeric ID of the ragCorpora resource.
# Full path is built automatically: projects/{PROJECT_ID}/locations/{LOCATION}/ragCorpora/{RAG_CORPUS_ID}
RAG_CORPUS_ID=6917529027641081856

# ── Agent Model ───────────────────────────────────────────────────────────────
DEMO_AGENT_MODEL=gemini-live-2.5-flash-native-audio

# ── Exotel Integration ────────────────────────────────────────────────────────
# Public-facing wss:// URL advertised back to Exotel in the ExoML <Stream> response.
# Must be reachable from Exotel's servers.  Update after GKE LoadBalancer assigns an IP.
# Example: BACKEND_WS_URL=wss://34.x.x.x  or  wss://your.domain.com
BACKEND_WS_URL=

# ── GCS Transcript Storage ────────────────────────────────────────────────────
GCS_RECORDINGS_BUCKET=mofsl-contact-center-recordings

# ── Server (local dev only — ignored in GKE) ──────────────────────────────────
HOST=0.0.0.0
PORT=8080
